<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy to ~/Library/LaunchAgents/com.izbrisani.show.plist
  Edit ProgramArguments paths, then:
    launchctl load ~/Library/LaunchAgents/com.izbrisani.show.plist
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.izbrisani.show</string>
    <key>ProgramArguments</key>
    <array>
      <string>/usr/local/bin/node</string>
      <string>/Users/SHARED/izbrisani/server/index.js</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/SHARED/izbrisani</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/izbrisani-show.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/izbrisani-show.err</string>
  </dict>
</plist>
