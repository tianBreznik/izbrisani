# Copy to desks.env.local and edit for the show network.
#   cp desks.env.example desks.env.local
#
# Used by: push-all.sh, start-all.sh, stop-all.sh

PI_USER=moderna

# Mac Mini show server (must be reachable from each Pi)
SHOW_URL=http://192.168.50.10:3847

# desk_id:user@host — one line per desk
DESK_1=moderna@192.168.50.11
DESK_2=moderna@192.168.50.12
DESK_3=moderna@192.168.50.13
DESK_4=moderna@192.168.50.14

REMOTE_DIR=/home/moderna/izbrisani-pyclient
# Unused by start-all.sh (always /usr/bin/python3 for SSH PATH). Kept for docs.
PYTHON=/usr/bin/python3

# Optional: dedicated key used by fleet scripts (default ~/.ssh/izbrisani_ed25519)
# SSH_KEY=/Users/you/.ssh/izbrisani_ed25519
