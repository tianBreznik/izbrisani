[Unit]
Description=anatomija pregona desk pyclient (pygame display + GPIO button)
After=network-online.target graphical.target
Wants=network-online.target

[Service]
Type=simple
User=moderna
WorkingDirectory=/home/moderna/izbrisani-pyclient
Environment=DESK_ID=2
Environment=SHOW_URL=http://192.168.8.117:3847
Environment=BUTTON_GPIO=17
Environment=LED_GPIO=
Environment=GPIOZERO_PIN_FACTORY=lgpio
Environment=SDL_VIDEODRIVER=x11
Environment=DISPLAY=:0
ExecStart=/usr/bin/python3 /home/moderna/izbrisani-pyclient/desk_client.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
