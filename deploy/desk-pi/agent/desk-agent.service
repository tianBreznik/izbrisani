[Unit]
Description=UN Debate desk companion (GPIO button → show server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/izbrisani-agent
Environment=DESK_ID=1
Environment=SHOW_URL=http://192.168.50.10:3847
Environment=BUTTON_GPIO=17
Environment=LED_GPIO=27
ExecStart=/usr/bin/python3 /home/pi/izbrisani-agent/desk_agent.py
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
