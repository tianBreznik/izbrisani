<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Installed by deploy/automation/mac/install.sh → ~/Library/LaunchAgents/
  Uses start-show-server.sh wrapper (sources show.env.local).
  Uninstall: deploy/automation/mac/uninstall.sh
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.izbrisani.show</string>
    <key>ProgramArguments</key>
    <array>
      <string>/bin/bash</string>
      <string>__AUTOMATION_MAC__/start-show-server.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/izbrisani-show.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/izbrisani-show.err</string>
  </dict>
</plist>
