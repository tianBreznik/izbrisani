# Show server env — copy to show.env.local (gitignored)

# Absolute path to izbrisani repo on this Mac
IZBRISANI_ROOT=/Users/YOU/izbrisani

# node binary (which node)
NODE_BIN=/usr/local/bin/node

# Show hardware (leave empty for stub / bench without devices)
SHELLY_URL=
ESP32_URL=
SEANCE_SETTLE_MS=3000

# Audio
AUDIO_BACKEND=osc
OSC_HOST=127.0.0.1
OSC_PORT=57120
OSC_LISTEN_PORT=57121

# Kodak carousel (optional overrides)
# KODAK_CONFIG_PATH=
# KODAK_ENABLED=1
